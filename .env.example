# ============================================================
#  Telegram Bot API
# ============================================================

# Токен от @BotFather. Обязателен.
BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# Разметка сообщений: HTML | MarkdownV2
BOT_PARSE_MODE=HTML

# Свой Bot API сервер (github.com/tdlib/telegram-bot-api).
# Нужен, если api.telegram.org недоступен из вашей сети
# или требуются повышенные лимиты. По умолчанию — официальный.
# BOT_API_URL=http://127.0.0.1:8081
# BOT_API_LOCAL=1

# Прокси до Telegram: http://, https:// или socks5://
# BOT_PROXY=socks5://127.0.0.1:9050

# Таймаут запроса к Bot API, секунд
BOT_REQUEST_TIMEOUT=60

# Long polling: длительность ожидания и пропуск обновлений,
# накопившихся, пока бот был выключен
BOT_POLLING_TIMEOUT=30
BOT_DROP_PENDING=1

# Рассылка уведомлений: пауза между сообщениями (~20 в секунду),
# максимальное ожидание по лимиту Telegram и число повторов
BOT_SEND_DELAY=0.05
BOT_MAX_RETRY_AFTER=300
BOT_SEND_RETRIES=2

# Telegram-id администраторов через запятую (пока не обязательно)
# BOT_ADMIN_IDS=111111111,222222222

# Лимит подписок на пользователя
MAX_SUBS_PER_USER=30

# Уведомлять, когда топливо закончилось (1/0)
ALERT_ON_GONE=1

# ============================================================
#  Опрос сайта и хранилище
# ============================================================

# Секунд между опросами. Значения меньше 120 автоматически
# поднимаются: это чужой публичный сервис, частые запросы
# приведут к блокировке IP вашего сервера.
POLL_INTERVAL=300

# Путь к базе. На сервере ставится юнитом в /var/lib/gpn/gpn.db
# GPN_DB=/var/lib/gpn/gpn.db

# Необязательный адрес API сайта вручную (обычно определяется автоматически)
# GPN_API_URL=https://gpnbonus.ru/api/...

# Ключ партнёрского API Benzuber. Необязателен; не загружайте настоящий ключ в Git.
# BENZUBER_API_KEY=replace_with_rotated_key

# Сколько записей истории хранить на каждую марку
HISTORY_LIMIT=60

# Сколько АЗС показывать на одной странице списка
PAGE_SIZE=8
